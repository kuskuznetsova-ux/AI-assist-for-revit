<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI-ассистент" Width="420" Height="640"
        WindowStartupLocation="Manual" ShowInTaskbar="False">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="history" Grid.Row="0" IsReadOnly="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontSize="13" Padding="6"/>
        <TextBlock x:Name="status" Grid.Row="1" Margin="2,6,2,4"
                   Foreground="Gray" FontSize="11"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="input" Grid.Column="0" Height="54" AcceptsReturn="False"
                     TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="4"
                     KeyDown="input_keydown"/>
            <Button x:Name="send" Grid.Column="1" Content="Отправить" Width="86"
                    Margin="6,0,0,0" Click="send_click"/>
        </Grid>
    </Grid>
</Window>
